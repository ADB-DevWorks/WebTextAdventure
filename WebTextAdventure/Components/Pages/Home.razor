@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Eternal Quest</PageTitle>

<div class="container parchment screen">
    <div class="banner">
        <h1 class="title">Eternal Quest</h1>
        <p class="subtitle">A 1980s fantasy text RPG</p>
    </div>

    <div class="ornament">✦ ✶ ✦</div>

    <div class="controls">
        
        <button class="button-fantasy" @onclick="NavigateToPage">New Game</button>
        
        <button class="button-fantasy">Load Game</button>
        <button class="button-fantasy">Options</button>
    </div>
</div>


@code 
{
    private void NavigateToPage() => Navigation.NavigateTo("game");
}



